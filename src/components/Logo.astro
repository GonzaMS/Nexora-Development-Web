---
// Logo de la marca. `oscuro` lo adapta para fondos oscuros.
interface Props {
  oscuro?: boolean;
  class?: string;
}
const { oscuro = false, class: clase = '' } = Astro.props;
const acento = oscuro ? '#5FD3B8' : '#0F8A74';
const texto = oscuro ? '#F4F6F5' : '#0E2A2F';
---

<span class={`inline-flex items-center gap-2.5 ${clase}`}>
  <svg viewBox="8 8 48 48" class="size-9 shrink-0" aria-hidden="true">
    <path d="M26 12c-6 0-8 2.5-8 7v7c0 3.5-2 5.5-6 6 4 .5 6 2.5 6 6v7c0 4.5 2 7 8 7" fill="none" stroke={acento} stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M38 12c6 0 8 2.5 8 7v7c0 3.5 2 5.5 6 6-4 .5-6 2.5-6 6v7c0 4.5-2 7-8 7" fill="none" stroke={texto} stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="32" cy="32" r="4.5" fill={acento}></circle>
  </svg>
  <span class="font-display text-xl leading-none tracking-tight" style={`color:${texto}`}>
    <b class="font-bold">CGSM</b> <span class="font-medium" style={`color:${acento}`}>Innova</span>
  </span>
</span>
