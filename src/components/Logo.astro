---
// Logo de la marca. `oscuro` lo adapta para fondos oscuros; `animado` dibuja la N trazo por trazo al cargar.
interface Props {
  oscuro?: boolean;
  animado?: boolean;
  class?: string;
}
const { oscuro = false, animado = false, class: clase = '' } = Astro.props;
const trazo = (n: number) => (animado ? `trazo trazo-${n}` : undefined);
const fondo = oscuro ? '#1C2740' : '#121A2B';
const texto = oscuro ? '#F5F7FA' : '#121A2B';
const acento = oscuro ? '#6EA8FF' : '#2F54EB';
// Cada instancia necesita su propio id de degradé (el logo aparece en el encabezado y en el pie).
const id = `nx-${oscuro ? 'oscuro' : 'claro'}`;
---

<span class={`inline-flex items-center gap-2.5 ${clase}`}>
  <svg viewBox="0 0 64 64" class="size-9 shrink-0" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="20" y1="20" x2="44" y2="44" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#2F54EB"></stop>
        <stop offset="1" stop-color="#6EA8FF"></stop>
      </linearGradient>
    </defs>
    <rect width="64" height="64" rx="16" fill={fondo}></rect>
    <g transform="translate(32 32) scale(.8) translate(-32 -32)" fill="none" stroke-width="8" stroke-linecap="round">
      <path class={trazo(1)} pathLength="1" d="M20 44V20" stroke="#FFFFFF"></path>
      <path class={trazo(2)} pathLength="1" d="M20 20l24 24" stroke={`url(#${id})`}></path>
      <path class={trazo(3)} pathLength="1" d="M44 44V20" stroke="#FFFFFF"></path>
    </g>
  </svg>
  <span class="font-display leading-none">
    <span class="block text-xl font-bold tracking-[0.12em]" style={`color:${texto}`}>NEXORA</span>
    <span class="mt-1 block text-[0.6rem] font-medium tracking-[0.26em]" style={`color:${acento}`}>DEVELOPMENT</span>
  </span>
</span>
