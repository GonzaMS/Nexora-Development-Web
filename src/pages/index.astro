---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { empresa, equipo } from '../data/empresa';
import { proyectos } from '../data/proyectos';

const [destacado, ...otros] = proyectos;
const whatsapp =
  empresa.whatsapp && `https://wa.me/${empresa.whatsapp}?text=${encodeURIComponent('Hola, quiero contarles sobre un proyecto.')}`;

const servicios = [
  {
    titulo: 'Sistemas web a medida',
    icono: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
    texto: 'Portales, paneles de gestión y sistemas internos pensados para cómo trabaja tu organización, no al revés. Funcionan en la computadora y en el celular.',
  },
  {
    titulo: 'Pagos e integraciones',
    icono: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>',
    texto: 'Conectamos tu sistema con pasarelas de pago, WhatsApp, correo y los servicios que ya usás, para que los datos no se carguen dos veces.',
  },
  {
    titulo: 'Asistentes con inteligencia artificial',
    icono: '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
    texto: 'Asistentes que responden preguntas con la información de tu organización y pasan la charla a una persona cuando hace falta.',
  },
  {
    titulo: 'Mantenimiento y soporte',
    icono: '<path d="M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.6 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.6 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
    texto: 'Después de entregar seguimos: copias de seguridad, vigilancia de errores, mejoras y ayuda a quienes usan el sistema todos los días.',
  },
];

const pasos = [
  {
    titulo: 'Te escuchamos',
    texto: 'Nos sentamos con quienes van a usar el sistema y entendemos el problema antes de proponer nada.',
  },
  {
    titulo: 'Te mostramos una demo',
    texto: 'En pocas semanas ves una versión que funciona, con tus datos de ejemplo, y decidís con algo concreto en la mano.',
  },
  {
    titulo: 'Construimos por etapas',
    texto: 'Entregamos en partes que ya se pueden usar, y ajustamos con lo que va surgiendo en el día a día.',
  },
  {
    titulo: 'Te acompañamos',
    texto: 'Capacitamos a tu equipo, ponemos el sistema en marcha y quedamos para el soporte y las mejoras.',
  },
];
---

<Base
  titulo="Nexora Development — Next generation technology"
  descripcion="Desarrollamos sistemas web, integraciones y asistentes con inteligencia artificial hechos a la medida de cada organización. Paraguay."
>
  <header class="sticky top-0 z-40 border-b border-linea/70 bg-niebla/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
      <a href="/" aria-label="Nexora Development, inicio"><Logo animado /></a>
      <nav aria-label="Principal" class="hidden items-center gap-7 text-[0.95rem] text-gris md:flex">
        <a class="hover:text-medianoche" href="#proyectos">Proyectos</a>
        <a class="hover:text-medianoche" href="#servicios">Qué hacemos</a>
        <a class="hover:text-medianoche" href="#como-trabajamos">Cómo trabajamos</a>
        <a class="hover:text-medianoche" href="#equipo">Equipo</a>
      </nav>
      <a href="#contacto" class="rounded-full bg-medianoche px-4 py-2 text-sm font-semibold text-niebla hover:bg-medianoche-2">
        Escribinos
      </a>
    </div>
  </header>

  <main id="contenido">
    <!-- Inicio: el título junto a capturas reales de Govly (panel en la computadora y portal en el celular). -->
    <section class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28">
      <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.15fr] lg:gap-10">
        <div>
          <p class="font-display text-sm font-bold tracking-[0.2em] text-azul uppercase">{empresa.bajada}</p>
          <h1 class="mt-5 font-display text-[2.4rem] leading-[1.02] font-bold tracking-[-0.03em] text-balance sm:text-6xl">
            Software moderno que crece con tu organización<span class="ml-1 inline-block size-[0.17em] rounded-full bg-azul align-baseline"></span>
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-gris sm:text-xl">
            Somos un equipo paraguayo de desarrollo. Construimos sistemas web, integraciones y asistentes con inteligencia artificial versátiles y escalables, pensados para cómo trabajás hoy y para lo que viene.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="#contacto" class="rounded-full bg-azul px-6 py-3 font-semibold text-white hover:bg-[#2443c9]">Contanos tu proyecto</a>
            <a href="#proyectos" class="font-semibold text-medianoche underline decoration-azul decoration-2 underline-offset-[6px] hover:decoration-medianoche">Ver lo que hicimos</a>
          </div>
        </div>
        <a href="#proyectos" class="relative block pr-[14%] pb-[10%] sm:pr-[12%]" aria-label="Ver Govly, el sistema municipal que hicimos">
          <figure class="overflow-hidden rounded-xl border border-medianoche/10 bg-medianoche shadow-[0_30px_80px_-25px_rgba(18,26,43,0.45)]">
            <div class="flex gap-1.5 border-b border-white/10 px-3 py-2.5" aria-hidden="true">
              <span class="size-2 rounded-full bg-white/20"></span>
              <span class="size-2 rounded-full bg-white/20"></span>
              <span class="size-2 rounded-full bg-white/20"></span>
            </div>
            <img src="/proyectos/govly-panel.jpg" alt="Panel de administración de Govly con lo recaudado en el mes, impuestos pendientes y pagos" width="1600" height="1000" fetchpriority="high" class="block h-auto w-full" />
          </figure>
          <figure class="absolute right-0 bottom-0 w-[30%] overflow-hidden rounded-[1.4rem] border-[5px] border-medianoche bg-medianoche shadow-[0_25px_60px_-15px_rgba(18,26,43,0.55)]">
            <img src="/proyectos/govly-celular.jpg" alt="Portal del ciudadano de Govly en el celular" width="780" height="1688" class="block h-auto w-full" />
          </figure>
        </a>
      </div>
    </section>

    <!-- Proyectos -->
    <section id="proyectos" class="oscuro bg-medianoche text-niebla">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Proyectos</h2>
        <p class="mt-4 max-w-xl text-lg text-niebla/75">Sistemas que ya están en uso o en camino, con la gente que los usa todos los días.</p>

        {destacado && (
          <article class="mt-14 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
            <div>
              <p class="text-celeste">{destacado.cliente}</p>
              <h3 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">{destacado.nombre}</h3>
              <p class="mt-1 text-sm text-niebla/60">{destacado.estado}, {destacado.anio}</p>
              <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-niebla/85">{destacado.resumen}</p>
              <ul class="mt-7 grid gap-x-8 gap-y-3 sm:grid-cols-2">
                {destacado.queHace.map((item) => (
                  <li class="flex gap-3 leading-snug text-niebla/90">
                    <span class="mt-[0.45em] size-1.5 shrink-0 rounded-full bg-celeste" aria-hidden="true"></span>
                    {item}
                  </li>
                ))}
              </ul>
              <p class="mt-8 text-sm text-niebla/60">Hecho con {destacado.tecnologias.join(', ')}.</p>
              {destacado.enlace && (
                <a href={destacado.enlace.url} target="_blank" rel="noopener" class="mt-8 inline-block rounded-full bg-celeste px-6 py-3 font-semibold text-medianoche hover:bg-white">
                  {destacado.enlace.texto}
                </a>
              )}
            </div>
            {destacado.imagen && (
              <figure class="self-start overflow-hidden rounded-xl border border-white/15 bg-medianoche-2 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.55)]">
                <div class="flex gap-1.5 border-b border-white/10 px-4 py-3" aria-hidden="true">
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                </div>
                <img src={destacado.imagen.src} alt={destacado.imagen.alt} width="1280" height="800" loading="lazy" class="block h-auto w-full" />
              </figure>
            )}
          </article>
        )}

        {otros.length > 0 && (
          <ul class="mt-20 grid gap-16 border-t border-white/15 pt-12">
            {otros.map((p) => (
              <li class="grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
                <div>
                  <p class="text-sm text-celeste">{p.cliente}</p>
                  <h3 class="mt-1 font-display text-2xl font-bold sm:text-3xl">{p.nombre}</h3>
                  <p class="mt-1 text-sm text-niebla/60">{p.estado}, {p.anio}</p>
                  <p class="mt-5 max-w-[62ch] leading-relaxed text-niebla/80">{p.resumen}</p>
                  <p class="mt-5 text-sm text-niebla/60">Hecho con {p.tecnologias.join(', ')}.</p>
                  {p.enlace && <a href={p.enlace.url} target="_blank" rel="noopener" class="mt-4 inline-block font-semibold text-celeste underline underline-offset-4">{p.enlace.texto}</a>}
                </div>
                <ul class="grid content-start gap-3 sm:grid-cols-2 lg:grid-cols-1">
                  {p.queHace.map((item) => (
                    <li class="flex gap-3 leading-snug text-niebla/90">
                      <span class="mt-[0.45em] size-1.5 shrink-0 rounded-full bg-celeste" aria-hidden="true"></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- Qué hacemos -->
    <section id="servicios" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">
        <div>
          <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Qué hacemos</h2>
          <p class="mt-4 max-w-sm text-lg text-gris">Para empresas, instituciones y municipios. Si tu problema se resuelve con software, lo charlamos.</p>
        </div>
        <dl class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
          {servicios.map((s) => (
            <div class="border-t-2 border-medianoche pt-5">
              <svg class="size-10 rounded-lg bg-azul/10 p-2 text-azul" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icono}></svg>
              <dt class="mt-4 font-display text-xl font-bold">{s.titulo}</dt>
              <dd class="mt-3 leading-relaxed text-gris">{s.texto}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Cómo trabajamos: es una secuencia real, por eso va numerada. -->
    <section id="como-trabajamos" class="border-y border-linea bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Cómo trabajamos</h2>
        <ol class="mt-14 grid gap-10 md:grid-cols-4 md:gap-8">
          {pasos.map((p, i) => (
            <li class="relative">
              <span class="font-display text-5xl font-bold text-azul" aria-hidden="true">{i + 1}</span>
              <h3 class="mt-3 font-display text-xl font-bold">{p.titulo}</h3>
              <p class="mt-2 leading-relaxed text-gris">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Equipo -->
    <section id="equipo" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Equipo</h2>
      <p class="mt-4 max-w-xl text-lg text-gris">Las personas que van a atender tu proyecto, de la primera reunión al soporte.</p>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {equipo.map((persona) => {
          const iniciales = persona.nombre.split(' ').map((n) => n[0]).join('').slice(0, 2);
          return (
            <li class="flex items-center gap-4">
              {persona.foto ? (
                <img src={persona.foto} alt="" width="160" height="160" loading="lazy" class="size-20 shrink-0 rounded-full object-cover" />
              ) : (
                <span class="grid size-20 shrink-0 place-items-center rounded-full bg-medianoche font-display text-xl font-bold text-celeste" aria-hidden="true">{iniciales}</span>
              )}
              <span>
                <span class="block font-semibold">{persona.nombre}</span>
                {persona.rol && <span class="block text-sm text-gris">{persona.rol}</span>}
              </span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="oscuro bg-medianoche text-niebla">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1.4fr_1fr] lg:items-end">
        <div>
          <h2 class="font-display text-4xl font-bold tracking-tight text-balance sm:text-6xl">Contanos qué necesitás</h2>
          <p class="mt-5 max-w-xl text-lg text-niebla/80">Respondemos en el día. La primera charla no tiene costo y no te compromete a nada.</p>
        </div>
        <div class="flex flex-col gap-4">
          {whatsapp && (
            <a href={whatsapp} target="_blank" rel="noopener" class="rounded-full bg-celeste px-6 py-4 text-center font-semibold text-medianoche hover:bg-white">
              Escribir por WhatsApp
              <span class="block text-sm font-normal">{empresa.whatsappVisible}</span>
            </a>
          )}
          <a
            href={`mailto:${empresa.email}`}
            class={whatsapp
              ? 'rounded-full border border-niebla/30 px-6 py-4 text-center font-semibold hover:border-celeste hover:text-celeste'
              : 'rounded-full bg-celeste px-6 py-4 text-center font-semibold text-medianoche hover:bg-white'}
          >
            Escribinos por correo
            <span class="block text-sm font-normal">{empresa.email}</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="oscuro bg-medianoche text-niebla">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-white/10 px-4 py-8 text-sm text-niebla/60 sm:px-6">
      <Logo oscuro />
      <p>{empresa.bajada}. {empresa.ciudad}, {new Date().getFullYear()}.</p>
      <a href="/privacidad" class="hover:text-niebla">Política de privacidad</a>
    </div>
  </footer>
</Base>
